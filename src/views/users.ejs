<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>All Registered Users</h2>

    <table border="1" cellpadding="10">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
            </tr>
        </thead>

        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role_name %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</main>

<%- include('partials/footer') %>