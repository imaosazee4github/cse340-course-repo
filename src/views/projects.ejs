<%- include('partials/header') %>
    <main class="projects-page">

        <section class="page-header">
            <h1><%= title %></h1>
            <h2>Upcoming Service Projects</h2>
             <p>
      Discover meaningful opportunities to serve your community, connect with
      volunteers, and make a positive impact through our upcoming service projects.
    </p>
        </section>

          <section class="projects-grid">

    <article class="project-card">
      <h2>Park Cleanup</h2>

      <p>
        Join volunteers in cleaning and restoring local parks to create a safer,
        cleaner, and more enjoyable environment for families and visitors.
      </p>

      <span class="project-category">Environmental Service</span>
    </article>

    <article class="project-card">
      <h2>Food Drive</h2>

      <p>
        Help collect, organize, and distribute food supplies to individuals and
        families in need within the community.
      </p>

      <span class="project-category">Community Support</span>
    </article>

    <article class="project-card">
      <h2>Community Tutoring</h2>

      <p>
        Volunteer your time and knowledge by tutoring students in various subjects
        and supporting academic growth.
      </p>

      <span class="project-category">Educational Support</span>
    </article>

  </section>
    </main>
<%- include('partials/footer') %>