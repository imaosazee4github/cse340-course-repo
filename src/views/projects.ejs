<%- include('partials/header') %>
    <main class="projects-page">

        <section class="page-header">
            <h1><%= title %></h1>
            <h2>Upcoming Service Projects</h2>
             <p>
      Discover meaningful opportunities to serve your community, connect with
      volunteers, and make a positive impact through our upcoming service projects.
    </p>
        </section>

          <section class="projects-grid">

            <% projects.forEach((project) => { %>
                <article class="project-card">
                    <div class="project-date">
                        <%= new Date(project.project_date).toLocaleDateString(
                            'en-US', {
                                weekday: 'long',
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric'
                            }
                            ) %>
                    </div>
                    <h2><%= project.project_title %></h2>
                    <h3>
                        Sponsored by: 
                        <span><%= project.organization_name %></span>
                    </h3>
                    <p><%= project.project_description %></p>
                       <p class="project-location">
                    📍 <%= project.location %>
                </p>
    </article>
    <% }) %>
  </section>
    </main>
<%- include('partials/footer') %>