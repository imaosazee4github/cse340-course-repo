<%- include('partials/header') %>

<main>

    <h1>Edit Category</h1>

    <form
        action="/edit-category/<%= category.category_id %>"
        method="POST">

        <div class="form-group">

            <label for="category_name">
                Category Name
            </label>

            <input
                type="text"
                id="category_name"
                name="category_name"
                value="<%= category.category_name %>"
                maxlength="100"
                required
            >

        </div>

        <button
            type="submit"
            class="btn btn-primary">

            Update Category

        </button>

    </form>

</main>

<%- include('partials/footer') %>