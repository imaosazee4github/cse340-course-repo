<%- include('partials/header') %>

<main class="organizations-page">

    <section class="page-header">
        <h1><%= title %></h1>
        <p>Here are a few of our partner organizations:</p>
    </section>

    <section class="organization-grid">

        <% organizations.forEach((organization) => { %>

            <article class="organization-card">

                <img 
                    src="/images/<%= organization.organization_logo %>" 
                    alt="<%= organization.organization_name %> logo" 
                    class="organization-logo"
                >

                <h3>
                    <a href="/organization/<%= organization.organization_id %>">
                        <%= organization.organization_name %>
                    </a>
                </h3>

                <p><%= organization.organization_email %></p>

                <p><%= organization.organization_description %></p>

            </article>

        <% }) %>

    </section>

</main>

<%- include('partials/footer') %>