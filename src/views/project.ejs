<%- include('partials/header') %>

<main class="project-details container">

    <% if (project) { %>

        <h1><%= project.title %></h1>

        <p>
            <strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString() %>
        </p>

        <p>
            <strong>Location:</strong>
            📍 <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <p><%= project.description %></p>

        <h3>Categories</h3>

        <% if (categories && categories.length > 0) { %>

            <ul>

                <% categories.forEach((category) => { %>

                    <li>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.category_name %>
                        </a>
                    </li>

                <% }) %>

            </ul>

        <% } else { %>

            <p>No categories available.</p>

        <% } %>

    <% } else { %>

        <p>Project not found.</p>
        
        <% } %>

         <% if (isLoggedIn) { %>
            <div class="volunteer-section">
                <% if (project.isVolunteer) { %>
                    <div class="volunteer-status status-active">
                        <p>✅ You are currently volunteering for this project!</p>
                        <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                            <button type="submit" class="btn btn-warning">
                                Remove Volunteering
                            </button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="volunteer-status status-inactive">
                        <p>🤝 Interested in helping? Sign up as a volunteer!</p>
                        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                            <button type="submit" class="btn btn-success">
                                Volunteer for This Project
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="volunteer-section">
                <p>🔒 Please <a href="/login">login</a> to volunteer for this project.</p>
            </div>
        <% } %>

<% if (isLoggedIn && user && user.role_name === 'admin') { %>
   <div class="project-actions">
    <a href="/edit-project/<%= project.project_id %>" class="btn btn-primary">
        Edit Project
    </a>

    <a href="/project/<%= project.project_id %>/assign-categories" class="btn  btn-success">
        Manage Categories
    </a>
</div>
<% } %>

</main>

<%- include('partials/footer') %>