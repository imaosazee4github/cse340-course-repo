<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | CSE 340 Service Network</title>
    <link rel="stylesheet" href="/css/main.css">

     <meta name="description" content="CSE 340 Service Network connects volunteers with organizations and community service opportunities.">
</head>

<body>
    <header class="site-header">
        <div class="container header-container">
            <div class="logo-section">
                <a href="/" class="site-logo">CSE 340 Service Network</a>
            </div>

        <nav class="main-nav">
        <ul class="nav-list">
         <li><a href="/">Home</a></li>
         <li><a href="/organizations">Organizations</a></li>
         <li><a href="/projects">Projects</a></li>
        <li><a href="/categories">Categories</a></li>
         <li><a href="/register">Register</a></li>
        </ul>
    </nav>
        </div> 
    </header>
     <!-- Flash Messages -->
<div class="container">

    <% const messages = flash(); %>

    <% Object.keys(messages).forEach(type => { %>

        <% if (messages[type].length > 0) { %>

            <div class="alert <%= type %>">

                <% messages[type].forEach(msg => { %>

                    <p><%= msg %></p>

                <% }); %>

            </div>

        <% } %>

    <% }); %>

</div>